{
  "$type": "GPMAutomateEditor.Models.SubEditor, GPMAutomateEditor.Models",
  "body": {
    "$type": "GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models",
    "nodes": [
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 120,
        "element_xpath": "//node[@text=\"For You\" and @class=\"android.widget.Button\"]",
        "output_variable_name": "",
        "delay": "0,0",
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000001",
        "display_text": "Wait element",
        "raw_input": "[{\"Key\":\"TIME_OUT\",\"Value\":\"20\"}]",
        "comment": "wait TikTok Lite For You"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "videoSwipeCount",
        "delay": "0,0",
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000002",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"3\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
        "comment": "set default video swipe count"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "screenWidth",
        "delay": "0,0",
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000003",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"1440\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
        "comment": "set fallback screen width"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "screenHeight",
        "delay": "0,0",
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000004",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"2960\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
        "comment": "set fallback screen height"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 114,
        "element_xpath": null,
        "output_variable_name": "screenSizeRaw",
        "delay": "0,0",
        "continue_on_error": true,
        "id": "f2010001-9000-4000-8000-000000000005",
        "display_text": "Execute ADB",
        "raw_input": "[{\"Key\":\"SCRIPT\",\"Value\":\"shell wm size\"}]",
        "comment": "read screen size"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 82,
        "element_xpath": null,
        "output_variable_name": "screenWidthRead",
        "delay": "0,0",
        "continue_on_error": true,
        "id": "f2010001-9000-4000-8000-000000000006",
        "display_text": "Regex",
        "raw_input": "[{\"Key\":\"TEXT\",\"Value\":\"$screenSizeRaw\"},{\"Key\":\"REGEX\",\"Value\":\"(?<=Physical size: )\\\\d+(?=x)\"}]",
        "comment": "read physical screen width"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 82,
        "element_xpath": null,
        "output_variable_name": "screenHeightRead",
        "delay": "0,0",
        "continue_on_error": true,
        "id": "f2010001-9000-4000-8000-000000000007",
        "display_text": "Regex",
        "raw_input": "[{\"Key\":\"TEXT\",\"Value\":\"$screenSizeRaw\"},{\"Key\":\"REGEX\",\"Value\":\"(?<=x)\\\\d+\"}]",
        "comment": "read physical screen height"
      },
      {
        "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
        "condition": "$screenWidthRead != \"\"",
        "nodes": [
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 1,
            "element_xpath": null,
            "output_variable_name": "screenWidth",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000008",
            "display_text": "Set variable",
            "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"$screenWidthRead\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
            "comment": "use detected screen width"
          }
        ],
        "expanded": true,
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000009",
        "display_text": "If",
        "raw_input": "[{\"Key\":\"CONDITION\",\"Value\":\"$screenWidthRead != \\\"\\\"\"}]",
        "comment": "screen width detected"
      },
      {
        "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
        "condition": "$screenHeightRead != \"\"",
        "nodes": [
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 1,
            "element_xpath": null,
            "output_variable_name": "screenHeight",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000010",
            "display_text": "Set variable",
            "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"$screenHeightRead\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
            "comment": "use detected screen height"
          }
        ],
        "expanded": true,
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000011",
        "display_text": "If",
        "raw_input": "[{\"Key\":\"CONDITION\",\"Value\":\"$screenHeightRead != \\\"\\\"\"}]",
        "comment": "screen height detected"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 7,
        "element_xpath": null,
        "output_variable_name": "",
        "delay": "0,0",
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000012",
        "display_text": "Delay",
        "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"3000\"},{\"Key\":\"MAX\",\"Value\":\"8000\"}]",
        "comment": "watch current video..."
      },
      {
        "$type": "GPMAutomateEditor.Models.ForBlockNode, GPMAutomateEditor.Models",
        "start": "0",
        "end": "$videoSwipeCount",
        "step": "1",
        "nodes": [
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 11,
            "element_xpath": null,
            "output_variable_name": "scrollStartXUnit",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000013",
            "display_text": "Random number",
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"8\"},{\"Key\":\"MAX\",\"Value\":\"12\"}]",
            "comment": "pick start x ratio"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 11,
            "element_xpath": null,
            "output_variable_name": "scrollStartYUnit",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000014",
            "display_text": "Random number",
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"16\"},{\"Key\":\"MAX\",\"Value\":\"17\"}]",
            "comment": "pick start y ratio"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 11,
            "element_xpath": null,
            "output_variable_name": "scrollEndXUnit",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000015",
            "display_text": "Random number",
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"8\"},{\"Key\":\"MAX\",\"Value\":\"12\"}]",
            "comment": "pick end x ratio"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 11,
            "element_xpath": null,
            "output_variable_name": "scrollEndYUnit",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000016",
            "display_text": "Random number",
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"8\"},{\"Key\":\"MAX\",\"Value\":\"9\"}]",
            "comment": "pick end y ratio"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 11,
            "element_xpath": null,
            "output_variable_name": "scrollDuration",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000017",
            "display_text": "Random number",
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"450\"},{\"Key\":\"MAX\",\"Value\":\"700\"}]",
            "comment": "pick video scroll duration"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 12,
            "element_xpath": null,
            "output_variable_name": "scrollStartX",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000018",
            "display_text": "Math execute",
            "raw_input": "[{\"Key\":\"MATH_EXPRESSION\",\"Value\":\"$screenWidth*$scrollStartXUnit/20\"}]",
            "comment": "scale start x"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 12,
            "element_xpath": null,
            "output_variable_name": "scrollStartY",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000019",
            "display_text": "Math execute",
            "raw_input": "[{\"Key\":\"MATH_EXPRESSION\",\"Value\":\"$screenHeight*$scrollStartYUnit/20\"}]",
            "comment": "scale start y"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 12,
            "element_xpath": null,
            "output_variable_name": "scrollEndX",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000020",
            "display_text": "Math execute",
            "raw_input": "[{\"Key\":\"MATH_EXPRESSION\",\"Value\":\"$screenWidth*$scrollEndXUnit/20\"}]",
            "comment": "scale end x"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 12,
            "element_xpath": null,
            "output_variable_name": "scrollEndY",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000021",
            "display_text": "Math execute",
            "raw_input": "[{\"Key\":\"MATH_EXPRESSION\",\"Value\":\"$screenHeight*$scrollEndYUnit/20\"}]",
            "comment": "scale end y"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 1,
            "element_xpath": null,
            "output_variable_name": "scrollStartPos",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000022",
            "display_text": "Set variable",
            "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"$scrollStartX,$scrollStartY\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
            "comment": "set video scroll start point"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 1,
            "element_xpath": null,
            "output_variable_name": "scrollEndPos",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000023",
            "display_text": "Set variable",
            "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"$scrollEndX,$scrollEndY\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
            "comment": "set video scroll end point"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 108,
            "element_xpath": null,
            "output_variable_name": null,
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000024",
            "display_text": "Scroll",
            "raw_input": "[{\"Key\":\"SCROLL_TYPE\",\"Value\":\"POINTS\"},{\"Key\":\"DIRECTION\",\"Value\":\"Up\"},{\"Key\":\"START_POS\",\"Value\":\"$scrollStartPos\"},{\"Key\":\"END_POS\",\"Value\":\"$scrollEndPos\"},{\"Key\":\"DURATION_MS\",\"Value\":\"$scrollDuration\"},{\"Key\":\"POS\",\"Value\":\"\"},{\"Key\":\"ACTION_TYPE\",\"Value\":\"Down\"}]",
            "comment": "scroll next TikTok video"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 7,
            "element_xpath": null,
            "output_variable_name": "",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "f2010001-9000-4000-8000-000000000025",
            "display_text": "Delay",
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"3000\"},{\"Key\":\"MAX\",\"Value\":\"8000\"}]",
            "comment": "watch new video..."
          }
        ],
        "expanded": false,
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000026",
        "display_text": "For",
        "raw_input": "[{\"Key\":\"START\",\"Value\":\"0\"},{\"Key\":\"END\",\"Value\":\"$videoSwipeCount\"},{\"Key\":\"STEP\",\"Value\":\"1\"}]",
        "comment": "scroll three new TikTok videos"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 11,
        "element_xpath": null,
        "output_variable_name": "commentRoll",
        "delay": "0,0",
        "continue_on_error": false,
        "id": "f2010001-9000-4000-8000-000000000027",
        "display_text": "Random number",
        "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"1\"},{\"Key\":\"MAX\",\"Value\":\"2\"}]",
        "comment": "pick comment action"
      },
      {
        "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
        "condition": "$commentRoll = 1 || $commentRoll = 2",
        "nodes": [
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 11,
            "element_xpath": null,
            "output_variable_name": "commentJitterX",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "4a389732-9648-4eb6-a964-c9da5608a041",
            "display_text": "Random number",
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"-15\"},{\"Key\":\"MAX\",\"Value\":\"15\"}]",
            "comment": "pick Comment x jitter"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 11,
            "element_xpath": null,
            "output_variable_name": "commentJitterY",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "825fe764-cab0-4ec9-9b93-486e33c6727d",
            "display_text": "Random number",
            "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"-15\"},{\"Key\":\"MAX\",\"Value\":\"15\"}]",
            "comment": "pick Comment y jitter"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 12,
            "element_xpath": null,
            "output_variable_name": "commentTapX",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "e0d1d0f5-9930-4ba4-a783-f381d64b0f4e",
            "display_text": "Math execute",
            "raw_input": "[{\"Key\":\"MATH_EXPRESSION\",\"Value\":\"1337+$commentJitterX\"}]",
            "comment": "make Comment tap x"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 12,
            "element_xpath": null,
            "output_variable_name": "commentTapY",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "146fcf7c-9594-45b0-8a5f-19aaf354b1e5",
            "display_text": "Math execute",
            "raw_input": "[{\"Key\":\"MATH_EXPRESSION\",\"Value\":\"1897+$commentJitterY\"}]",
            "comment": "make Comment tap y"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 1,
            "element_xpath": null,
            "output_variable_name": "commentPos",
            "delay": "0,0",
            "continue_on_error": false,
            "id": "c759aa6f-b7c9-4315-b976-2bd3b59985c5",
            "display_text": "Set variable",
            "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"$commentTapX,$commentTapY\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
            "comment": "set tested Comment position with jitter"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$commentPos != \"\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 1,
                "element_xpath": null,
                "output_variable_name": "flow2Result",
                "delay": "0,0",
                "continue_on_error": false,
                "id": "8ddde0c5-6644-4d0c-bcb3-4b1e2620080e",
                "display_text": "Set variable",
                "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"COMMENT_TAP_TARGET_$commentPos\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
                "comment": "log Comment tap coordinate"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 107,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "0,0",
                "continue_on_error": false,
                "id": "45cae426-5b86-469a-9d23-33da0a3c5d2b",
                "display_text": "Touch",
                "raw_input": "[{\"Key\":\"TOUCH_TYPE\",\"Value\":\"TOUCH_POS\"},{\"Key\":\"XPATH\",\"Value\":\"\"},{\"Key\":\"POS\",\"Value\":\"$commentPos\"},{\"Key\":\"MODE\",\"Value\":\"Normal\"}]",
                "comment": "touch found Comment position"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 7,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "0,0",
                "continue_on_error": false,
                "id": "61c442a1-aed5-47f7-a411-0252f5bf99db",
                "display_text": "Delay",
                "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"6000\"},{\"Key\":\"MAX\",\"Value\":\"10000\"}]",
                "comment": "wait comment panel..."
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 32,
                "element_xpath": null,
                "output_variable_name": "commentPanelExists",
                "delay": "0,0",
                "continue_on_error": false,
                "id": "c6f4a8f2-7974-4b24-8e38-574cb37a879a",
                "display_text": "Image exists",
                "raw_input": "[{\"Key\":\"IMG\",\"Value\":\"tiktok_verifypanelcomment.img64\"},{\"Key\":\"THRESH_HOLD\",\"Value\":\"0.8\"},{\"Key\":\"TRUE_COLOR\",\"Value\":\"No\"}]",
                "comment": "verify TikTok comment panel"
              },
              {
                "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                "condition": "$commentPanelExists = \"true\"",
                "nodes": [
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 1,
                    "element_xpath": null,
                    "output_variable_name": "flow2Result",
                    "delay": "0,0",
                    "continue_on_error": false,
                    "id": "12ed3d42-3a17-44e8-93dd-7b54c0e93907",
                    "display_text": "Set variable",
                    "raw_input": "[{\"Key\":\"VALUE\",\"Value\":\"COMMENT_PANEL_OPEN\"},{\"Key\":\"ALLOW_USER_INPUT\",\"Value\":\"False\"},{\"Key\":\"USER_INPUT_TYPE\",\"Value\":\"Text\"},{\"Key\":\"COMBOBOX_DATA\",\"Value\":\"\"},{\"Key\":\"INPUT_REQUIRED\",\"Value\":\"False\"}]",
                    "comment": "log comment panel open"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 11,
                    "element_xpath": null,
                    "output_variable_name": "commentScrollCount",
                    "delay": "0,0",
                    "continue_on_error": false,
                    "id": "abd0c9af-7261-4d2a-9f5b-e854531271b4",
                    "display_text": "Random number",
                    "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"2\"},{\"Key\":\"MAX\",\"Value\":\"4\"}]",
                    "comment": "pick comment up scroll count"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ForBlockNode, GPMAutomateEditor.Models",
                    "start": "0",
                    "end": "$commentScrollCount",
                    "step": "1",
                    "nodes": [
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 11,
                        "element_xpath": null,
                        "output_variable_name": "commentScrollX",
                        "delay": "0,0",
                        "continue_on_error": false,
                        "id": "dd7eb0ec-4a8d-43a9-8af5-34ec0ec1b393",
                        "display_text": "Random number",
                        "raw_input": "[{\"Key\":\"MIN\",\"Value\":\"360\"},{\"Key\":\"MAX\",\"Value\":\"1080\"}]",
                        "comment": "pick comment scroll x"
                      },
                      {
